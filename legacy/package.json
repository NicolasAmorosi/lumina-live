{
  "name": "worship-app",
  "version": "1.0.0",
  "description": "Aplicación de presentación para iglesia - Reemplazo de EasyWorship",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder build --win",
    "pack": "electron-builder --dir"
  },
  "author": "WorshipApp",
  "license": "MIT",
  "devDependencies": {
    "electron": "36.4.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.worshipapp.app",
    "productName": "WorshipApp",
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es"
      ],
      "language": "3082"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "data/**/*",
      "assets/**/*"
    ]
  }
}
