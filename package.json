{
  "name": "worship-app",
  "version": "2.0.0",
  "description": "Aplicación de proyección para iglesias - Reemplazo de EasyWorship",
  "main": "./out/main/index.js",
  "author": "WorshipApp",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:smoke": "TSX_TSCONFIG_PATH=tsconfig.node.json tsx scripts/db-smoke.ts",
    "slides:smoke": "TSX_TSCONFIG_PATH=tsconfig.node.json tsx scripts/convert-smoke.ts",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.27.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "com.worshipapp.app",
    "productName": "WorshipApp",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "npmRebuild": false,
    "files": [
      "out/**",
      "package.json",
      "!**/node_modules/@napi-rs/**",
      "!**/node_modules/pdfjs-dist/{build,web,image_decoders}/**"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "migrations"
      },
      {
        "from": "resources/bibles",
        "to": "bibles"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es"
      ],
      "language": "3082"
    }
  }
}
